{
  // Configuración relacionada con el sistema de logging de ASP.NET Core.
  "Logging": {
    "LogLevel": {
      // Nivel mínimo de logs generales que se mostrarán.
      "Default": "Information",

      // Para ASP.NET Core se utiliza Warning como nivel mínimo.
      // Esto evita mostrar demasiados mensajes internos.
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Permite que la aplicación reciba solicitudes desde cualquier host.
  "AllowedHosts": "*",

  // Contiene las cadenas utilizadas para conectarse
  // a diferentes bases de datos.
  "ConnectionStrings": {

    // Nombre de la cadena de conexión.
    // Este mismo nombre es utilizado por DapperContext:
    //
    // GetConnectionString("NorthwindConnection")
    //
    // La cadena indica cómo conectarse al SQL Server local.
    "NorthwindConnection": "server=localhost; database=Northwind; User Id=sa; Password=Pentaho*; trustServerCertificate=true;"
  }
}